# AnythingLLM runtime configuration
# This file is bind-mounted directly to /app/server/.env inside the container.
# AnythingLLM writes back to this file as settings are changed in the UI
# (LLM provider, vector DB, embedder, etc.), so treat it as live app state,
# not a one-time template.
#
# Copy this file to `.env` before first `docker-compose up`:
#   cp .env.example .env

STORAGE_DIR="/app/server/storage"

# Random secret used to sign JWTs for AnythingLLM's own auth sessions.
# Generate one with: openssl rand -hex 32
JWT_SECRET="generate_a_random_64_char_hex_string_here"
