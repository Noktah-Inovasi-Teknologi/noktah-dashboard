# Copy this file to .env and fill in your actual value

# OpenRouter API key — used for content analysis
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Analysis models are NOT set here: config/ai/models.yaml lists the accepted
# models for image and video, best value first, and roach rotates through them
# after repeated failures. OPENROUTER_MODEL / OPENROUTER_IMAGE_MODEL are ignored
# (roach warns at startup if they are still set).

# OpenRouter provider routing (optional). Same model, deterministic providers.
# First entry is the primary (Xiaomi hosts MiMo directly); the rest are ordered
# fallbacks used only when earlier ones are unavailable. Fixes the empty-content
# and image-422 failures caused by random provider selection.
# OPENROUTER_PROVIDER_ORDER=Xiaomi,DigitalOcean,NovitaAI,Parasail
# OPENROUTER_ALLOW_FALLBACKS=true

# Analysis token/compression tuning (optional). Video is compressed with ffmpeg
# before analysis (audio kept for the transcript) — ~5-10x fewer tokens. Raise
# height/CRF if a spot-check shows accuracy regressing.
# ANALYZE_VIDEO_MAX_HEIGHT=480     # downscale height cap
# ANALYZE_VIDEO_FPS=15             # frame-rate cap
# ANALYZE_VIDEO_CRF=30             # x264 quality (higher = smaller/lower quality)
# ANALYZE_VIDEO_MAX_SECONDS=0      # 0 = no trim
# ANALYZE_VIDEO_MAX_TOKENS=8000
# ANALYZE_IMAGE_MAX_TOKENS=3000
# ANALYZE_MAX_IMAGES=8            # cap carousel slides sent
# ANALYZE_IMAGE_MAX_DIM=1024      # downscale images to this longest side

# Anti-detection tuning (optional). One browser identity is chosen per profile
# from the pool and used consistently across that profile's requests, varying
# across profiles/runs. Egress normally goes direct (e.g. a mobile hotspot);
# set a proxy only if you route through one.
# YT_DLP_IMPERSONATE_POOL=chrome,chrome-124,safari,edge-99
# HARVEST_ACCEPT_LANGUAGE=en-US,en;q=0.9
# TIKTOK_PASS_DELAY_RANGE=5.0-10.0   # jittered "min-max" seconds between TikTok passes
# GALLERY_DL_403_THRESHOLD=3         # >= this many 403s => raise rate_limited (defer + rotate IP)
# PROXY_URL=                          # all egress; empty = direct
# INSTAGRAM_PROXY_URL=                # per-platform overrides of PROXY_URL
# TIKTOK_PROXY_URL=

# Shared secret required on the X-API-KEY header for all roach API endpoints
# except /health. Generate any random string; must match ROACH_API_KEY set on
# the prefect service.
ROACH_API_KEY=your_roach_api_key
