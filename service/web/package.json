{
  "name": "noktah-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt build && wrangler dev",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "deploy": "nuxt build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test:ui": "bun test tests/ui-conventions.test.ts",
    "ui:gate": "playwright test e2e/ui-sweep.e2e.ts",
    "ui:sweep": "UI_SWEEP_FULL=1 UI_SWEEP_SOFT=1 playwright test e2e/ui-sweep.e2e.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.134",
    "@iconify-json/simple-icons": "^1.2.96",
    "@nuxt/ui": "^4.11.1",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.138.0"
  },
  "packageManager": "bun@1.4.2"
}
