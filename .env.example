# .env.example - Template for environment variables
# Copy this file to .env and fill in your actual values

# Database Configuration
POSTGRES_DB=noktah_dashboard
POSTGRES_DB_DEV=noktah_dashboard_dev
POSTGRES_DB_PREFECT=prefect
POSTGRES_USER=noktah
POSTGRES_PASSWORD=your_secure_db_password_here

# Prefect
# Basic auth for the Prefect UI/API, in "user:password" form. Required by the
# prefect + prefect-worker containers. Change before exposing via the tunnel.
PREFECT_API_AUTH_STRING=admin:change_me

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_here

# Google Drive Integration
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Jira Integration (content-plan workflow)
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your_email@domain.com
JIRA_API_TOKEN=your_jira_api_token   # mapped to JIRA_TOKEN inside the container

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key

# Sentry Configuration (optional)
SENTRY_DSN=your_sentry_dsn_url

# Email Configuration  
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_email_address
SMTP_PASSWORD=your_email_password

# Cloudflare Configuration
DOMAIN_NAME=your_domain_name
# Tunnel token from Zero Trust > Networks > Tunnels (the value after `--token`)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# AnythingLLM Admin (multi-user mode root account, set via API — not read by the container)
ANYTHINGLLM_ADMIN_USERNAME=admin
ANYTHINGLLM_ADMIN_PASSWORD=your_secure_admin_password

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Kinde Authentication
NUXT_KINDE_AUTH_DOMAIN=https://your-business.kinde.com
NUXT_KINDE_CLIENT_ID=your_kinde_client_id
NUXT_KINDE_CLIENT_SECRET=your_kinde_client_secret
NUXT_KINDE_REDIRECT_URL=http://localhost:3000/api/auth/kinde_callback
NUXT_KINDE_LOGOUT_REDIRECT_URL=http://localhost:3000
NUXT_KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard