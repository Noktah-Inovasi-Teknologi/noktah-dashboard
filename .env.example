# .env.example - Template for environment variables
# Copy this file to .env and fill in your actual values

# Database Configuration
POSTGRES_DB=noktah_dashboard
POSTGRES_USER=noktah
POSTGRES_PASSWORD=your_secure_db_password_here

# JWT Secret (generate a strong random string)
JWT_SECRET=your_jwt_secret_here

# Google Drive Integration
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# OpenRouter API (used by roach analysis AND songbird content generation)
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional: override the house generation model
OPENROUTER_MODEL=xiaomi/mimo-v2.5

# Songbird content generation (feature 003)
# Google Drive folder where draft content plans are written
SONGBIRD_DRIVE_PARENT_ID=your_songbird_drafts_drive_folder_id
# Per-client monthly quantity source (defaults shown; override only if the sheet differs)
# SONGBIRD_CLIENTS_SPREADSHEET_ID=1-aV46TIn4m_zs3vtCNeS_Bvl3Tt-tgg09uuG_NqgNNY
# SONGBIRD_CLIENTS_TAB=Clients
# SONGBIRD_CLIENTS_NAME_COLUMN=Client
# SONGBIRD_QUANTITY_COLUMN=Jumlah Konten
# --target live writes to the client's own "Content Plan - {client} - {month}" sheet,
# found in its Content Plan folder. There is no env override (the old one pointed at the Clients roster).

# Sentry Configuration (optional)
SENTRY_DSN=your_sentry_dsn_url

# Email Configuration  
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_email_address
SMTP_PASSWORD=your_email_password

# Cloudflare Configuration
DOMAIN_NAME=your_domain_name
# Tunnel token from Zero Trust > Networks > Tunnels (the value after `--token`)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Kinde Authentication
NUXT_KINDE_AUTH_DOMAIN=https://your-business.kinde.com
NUXT_KINDE_CLIENT_ID=your_kinde_client_id
NUXT_KINDE_CLIENT_SECRET=your_kinde_client_secret
NUXT_KINDE_REDIRECT_URL=http://localhost:3000/api/auth/kinde_callback
NUXT_KINDE_LOGOUT_REDIRECT_URL=http://localhost:3000
NUXT_KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard
# Noktah Hub (spec 008)
HUB_API_INTERNAL_TOKEN=generate_a_long_random_token   # shared by prefect and hub-api; /internal/* only
# (AI models for every case are listed in config/ai/models.yaml, not here.)
# HUB_AI_MONTHLY_CAP_USD=5
SLACK_MANAGERIAL_ESKALA=https://hooks.slack.com/services/...   # #eskala-managerial (approval notices)
SLACK_MANAGERIAL_NOKTAH=https://hooks.slack.com/services/...   # #noktah-managerial (Venyu, until it has its own)
